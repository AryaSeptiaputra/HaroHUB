SECRET_KEY=your-secret-key-here

# Kosongkan untuk SQLite (development). Isi dengan postgres://... untuk production.
DATABASE_URL=

# Google Maps Platform — dua key terpisah
# Frontend key: restrict by HTTP referrer di GCP Console
# Backend key: restrict by IP di GCP Console
GOOGLE_MAPS_API_KEY_FRONTEND=
GOOGLE_MAPS_API_KEY_BACKEND=

DJANGO_SETTINGS_MODULE=config.settings.development
